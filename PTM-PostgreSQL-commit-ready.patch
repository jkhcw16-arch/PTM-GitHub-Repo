diff -ruN '--exclude=node_modules' '--exclude=package-lock.json' a/tests/integration/postgres.live.test.ts b/tests/integration/postgres.live.test.ts
--- a/tests/integration/postgres.live.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/integration/postgres.live.test.ts	2026-11-06 11:39:18.911466990 +0000
@@ -0,0 +1,38 @@
+import test,{before,after,beforeEach} from 'node:test';
+import assert from 'node:assert/strict';
+import {Pool} from 'pg';
+import {readFile} from 'node:fs/promises';
+import {PostgresUnitOfWork} from '../../adapters/postgres/unit-of-work.js';
+import {StaticRegistryResolver} from '../../adapters/postgres/registry.js';
+
+const DATABASE_URL=process.env.DATABASE_URL;
+if(!DATABASE_URL) throw new Error('DATABASE_URL_REQUIRED_FOR_LIVE_TESTS');
+const pool=new Pool({connectionString:DATABASE_URL});
+const registry={id:'schema:test',version:'1',axes:[{id:'a',position:0,prime:'2'},{id:'b',position:1,prime:'3'},{id:'c',position:2,prime:'5'}]};
+const registries=new StaticRegistryResolver([registry]);
+let uow:PostgresUnitOfWork;
+const now='2026-01-01T00:00:00.000Z';
+function state(id:string,tenant='tenant:a',vector:any=[{axis:'a',value:'1'}]){return{id,tenantId:tenant,registryId:registry.id,registryVersion:registry.version,temporalPosition:now,vector,provenanceRefs:['prov:1'],createdAt:now};}
+
+before(async()=>{const sql=await readFile(new URL('../../adapters/postgres/schema.sql',import.meta.url),'utf8');await pool.query(sql);uow=new PostgresUnitOfWork(registries,{connectionString:DATABASE_URL,max:4});});
+beforeEach(async()=>{await pool.query('TRUNCATE ptm_evidence,ptm_transitions,ptm_states');});
+after(async()=>{await uow.close();await pool.end();});
+
+test('migration created repository tables',async()=>{const r=await pool.query("SELECT tablename FROM pg_tables WHERE schemaname='public' AND tablename LIKE 'ptm_%' ORDER BY tablename");assert.deepEqual(r.rows.map(x=>x.tablename),['ptm_evidence','ptm_states','ptm_transitions']);});
+
+test('state round trip is canonical and tenant isolated',async()=>{await uow.transaction(async tx=>{await tx.states.put(state('s1','tenant:a',[{axis:'c',value:'3'},{axis:'a',value:'1'}]));});
+ const a=await uow.transaction(tx=>tx.states.get('tenant:a','s1'));assert.deepEqual(a?.vector,[{axis:'a',value:'1'},{axis:'c',value:'3'}]);
+ const b=await uow.transaction(tx=>tx.states.get('tenant:b','s1'));assert.equal(b,null);
+});
+
+test('optimistic concurrency rejects stale write',async()=>{const v1=await uow.transaction(tx=>tx.states.put(state('s1'),0n));assert.equal(v1,1n);const v2=await uow.transaction(tx=>tx.states.put({...state('s1'),vector:[{axis:'a',value:'2'}]},1n));assert.equal(v2,2n);await assert.rejects(()=>uow.transaction(tx=>tx.states.put({...state('s1'),vector:[{axis:'a',value:'3'}]},1n)),/CONCURRENCY_CONFLICT/);});
+
+test('transition persists signed arbitrary precision delta',async()=>{const huge='92233720368547758081234567890';await uow.transaction(async tx=>{await tx.states.put(state('s1'));await tx.states.put(state('s2'));await tx.transitions.put({id:'tr1',tenantId:'tenant:a',registryId:registry.id,registryVersion:registry.version,sourceStateId:'s1',targetStateId:'s2',delta:[{axis:'b',value:'-4'},{axis:'c',value:huge}],createdAt:now});});const t=await uow.transaction(tx=>tx.transitions.get('tenant:a','tr1'));assert.deepEqual(t?.delta,[{axis:'b',value:'-4'},{axis:'c',value:huge}]);});
+
+test('transition lookup by state is tenant qualified and bounded',async()=>{await uow.transaction(async tx=>{await tx.transitions.put({id:'tr1',tenantId:'tenant:a',registryId:registry.id,registryVersion:registry.version,sourceStateId:'s1',targetStateId:'s2',delta:[{axis:'a',value:'1'}],createdAt:now});await tx.transitions.put({id:'tr2',tenantId:'tenant:b',registryId:registry.id,registryVersion:registry.version,sourceStateId:'s1',targetStateId:'s3',delta:[{axis:'a',value:'2'}],createdAt:now});});const rows=await uow.transaction(tx=>tx.transitions.listByState('tenant:a','s1',10));assert.deepEqual(rows.map(x=>x.id),['tr1']);});
+
+test('mutation and evidence commit atomically',async()=>{await uow.transaction(async tx=>{await tx.states.put(state('s1'));await tx.evidence.append({tenantId:'tenant:a',evidenceId:'ev1',resourceType:'state',resourceId:'s1',evidenceType:'created',payload:{source:'integration-test'},createdAt:now});});const counts=await pool.query('SELECT (SELECT count(*)::int FROM ptm_states) states,(SELECT count(*)::int FROM ptm_evidence) evidence');assert.deepEqual(counts.rows[0],{states:1,evidence:1});});
+
+test('failed transaction rolls back state and evidence',async()=>{await assert.rejects(()=>uow.transaction(async tx=>{await tx.states.put(state('s1'));await tx.evidence.append({tenantId:'tenant:a',evidenceId:'ev1',resourceType:'state',resourceId:'s1',evidenceType:'created',payload:{ok:true},createdAt:now});throw new Error('FORCED_FAILURE');}),/FORCED_FAILURE/);const counts=await pool.query('SELECT (SELECT count(*)::int FROM ptm_states) states,(SELECT count(*)::int FROM ptm_evidence) evidence');assert.deepEqual(counts.rows[0],{states:0,evidence:0});});
+
+test('database enforces primary-key uniqueness',async()=>{await uow.transaction(tx=>tx.states.put(state('s1')));await assert.rejects(()=>uow.transaction(tx=>tx.states.put(state('s1'),99n)),/CONCURRENCY_CONFLICT/);});
diff -ruN '--exclude=node_modules' '--exclude=package-lock.json' a/tests/postgres-adapter.test.ts b/tests/postgres-adapter.test.ts
--- a/tests/postgres-adapter.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/postgres-adapter.test.ts	2026-11-06 11:29:31.000000000 +0000
@@ -0,0 +1,12 @@
+import test from 'node:test';import assert from 'node:assert/strict';
+import { PostgresStateRepository,PostgresTransitionRepository,PostgresEvidenceRepository } from '../adapters/postgres/repositories.js';
+import { StaticRegistryResolver } from '../adapters/postgres/registry.js';
+import type { QueryResult,Queryable } from '../packages/persistence/ports.js';
+const registry={id:'schema:test',version:'1',axes:[{id:'a',position:0,prime:'2'},{id:'b',position:1,prime:'3'}]};
+class FakeDb implements Queryable{calls:{text:string;values:readonly unknown[]}[]=[];responses:QueryResult<any>[]=[];async query<R>(text:string,values:readonly unknown[]=[]):Promise<QueryResult<R>>{this.calls.push({text,values});return (this.responses.shift()??{rows:[],rowCount:0}) as QueryResult<R>}}
+const state={id:'s1',tenantId:'t1',registryId:'schema:test',registryVersion:'1',temporalPosition:'2026-01-01T00:00:00.000Z',vector:[{axis:'b',value:'2'},{axis:'a',value:'1'}],provenanceRefs:['p1'],createdAt:'2026-01-01T00:00:00.000Z'};
+test('state put parameterizes data and canonicalizes vector',async()=>{const db=new FakeDb();db.responses.push({rows:[{version:'1'}],rowCount:1});const repo=new PostgresStateRepository(db,new StaticRegistryResolver([registry]));assert.equal(await repo.put(state,0n),1n);assert.match(db.calls[0].text,/\$1/);assert.equal(db.calls[0].values[0],'t1');assert.equal(db.calls[0].values[5],JSON.stringify([{axis:'a',value:'1'},{axis:'b',value:'2'}]));});
