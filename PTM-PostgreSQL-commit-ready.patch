@@ -0,0 +1,7 @@
+import type { AxisRegistry } from '../../packages/core/model.js';
+export interface RegistryResolver { get(id:string,version:string):Promise<AxisRegistry>; }
+export class StaticRegistryResolver implements RegistryResolver {
+  private readonly items=new Map<string,AxisRegistry>();
+  constructor(registries:readonly AxisRegistry[]){for(const r of registries)this.items.set(`${r.id}@${r.version}`,r)}
+  async get(id:string,version:string):Promise<AxisRegistry>{const r=this.items.get(`${id}@${version}`);if(!r)throw new Error('REGISTRY_NOT_FOUND');return r;}
+}
diff -ruN '--exclude=node_modules' '--exclude=package-lock.json' a/adapters/postgres/repositories.ts b/adapters/postgres/repositories.ts
--- a/adapters/postgres/repositories.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/adapters/postgres/repositories.ts	2026-11-06 11:29:31.000000000 +0000
@@ -0,0 +1,33 @@
+import type { State, Transition } from '../../packages/core/model.js';
+import { canonicalize } from '../../packages/core/vector.js';
+import type { EvidenceRecord, Queryable, StateRepository, TransitionRepository, EvidenceRepository } from '../../packages/persistence/ports.js';
+import type { RegistryResolver } from './registry.js';
+import { stateFromRow, transitionFromRow, type StateRow, type TransitionRow } from './codec.js';
+
+export class PostgresStateRepository implements StateRepository {
+  constructor(private readonly db:Queryable,private readonly registries:RegistryResolver){}
+  async get(tenantId:string,id:string):Promise<State|null>{
+    const q=await this.db.query<StateRow>('SELECT * FROM ptm_states WHERE tenant_id=$1 AND state_id=$2',[tenantId,id]);
+    if(!q.rows[0])return null; const r=q.rows[0]; return stateFromRow(r,await this.registries.get(r.registry_id,r.registry_version));
+  }
+  async put(state:State,expectedVersion:bigint=0n):Promise<bigint>{
+    const registry=await this.registries.get(state.registryId,state.registryVersion); const v=canonicalize(state.vector,registry);
+    const q=await this.db.query<{version:string}>(`INSERT INTO ptm_states(tenant_id,state_id,registry_id,registry_version,temporal_position,vector,provenance_refs,created_at,version)
+      VALUES($1,$2,$3,$4,$5,$6::jsonb,$7::jsonb,$8,1)
+      ON CONFLICT(tenant_id,state_id) DO UPDATE SET registry_id=EXCLUDED.registry_id,registry_version=EXCLUDED.registry_version,temporal_position=EXCLUDED.temporal_position,vector=EXCLUDED.vector,provenance_refs=EXCLUDED.provenance_refs,version=ptm_states.version+1
+      WHERE ptm_states.version=$9 RETURNING version`,[state.tenantId,state.id,state.registryId,state.registryVersion,state.temporalPosition,JSON.stringify(v),JSON.stringify(state.provenanceRefs),state.createdAt,expectedVersion.toString()]);
+    if(!q.rows[0])throw new Error('CONCURRENCY_CONFLICT'); return BigInt(q.rows[0].version);
+  }
+}
+
+export class PostgresTransitionRepository implements TransitionRepository {
+  constructor(private readonly db:Queryable,private readonly registries:RegistryResolver){}
+  async get(tenantId:string,id:string):Promise<Transition|null>{const q=await this.db.query<TransitionRow>('SELECT * FROM ptm_transitions WHERE tenant_id=$1 AND transition_id=$2',[tenantId,id]);if(!q.rows[0])return null;const r=q.rows[0];return transitionFromRow(r,await this.registries.get(r.registry_id,r.registry_version));}
+  async put(t:Transition):Promise<void>{const registry=await this.registries.get(t.registryId,t.registryVersion);const delta=canonicalize(t.delta,registry);await this.db.query(`INSERT INTO ptm_transitions(tenant_id,transition_id,source_state_id,target_state_id,registry_id,registry_version,delta,created_at) VALUES($1,$2,$3,$4,$5,$6,$7::jsonb,$8)`,[t.tenantId,t.id,t.sourceStateId,t.targetStateId,t.registryId,t.registryVersion,JSON.stringify(delta),t.createdAt]);}
+  async listByState(tenantId:string,stateId:string,limit=100):Promise<Transition[]>{const n=Math.max(1,Math.min(500,Math.trunc(limit)));const q=await this.db.query<TransitionRow>('SELECT * FROM ptm_transitions WHERE tenant_id=$1 AND (source_state_id=$2 OR target_state_id=$2) ORDER BY created_at,transition_id LIMIT $3',[tenantId,stateId,n]);return Promise.all(q.rows.map(async r=>transitionFromRow(r,await this.registries.get(r.registry_id,r.registry_version))));}
+}
+
+export class PostgresEvidenceRepository implements EvidenceRepository {
+  constructor(private readonly db:Queryable){}
+  async append(r:EvidenceRecord):Promise<void>{await this.db.query('INSERT INTO ptm_evidence(tenant_id,evidence_id,resource_type,resource_id,evidence_type,payload,created_at) VALUES($1,$2,$3,$4,$5,$6::jsonb,$7)',[r.tenantId,r.evidenceId,r.resourceType,r.resourceId,r.evidenceType,JSON.stringify(r.payload),r.createdAt]);}
+}
diff -ruN '--exclude=node_modules' '--exclude=package-lock.json' a/adapters/postgres/unit-of-work.ts b/adapters/postgres/unit-of-work.ts
--- a/adapters/postgres/unit-of-work.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/adapters/postgres/unit-of-work.ts	2026-11-06 11:29:31.000000000 +0000
@@ -0,0 +1,18 @@
+import { Pool, type PoolClient, type PoolConfig } from 'pg';
+import type { TransactionContext, UnitOfWork } from '../../packages/persistence/ports.js';
+import type { RegistryResolver } from './registry.js';
+import { PostgresEvidenceRepository, PostgresStateRepository, PostgresTransitionRepository } from './repositories.js';
+
+export class PostgresUnitOfWork implements UnitOfWork {
+  private readonly pool:Pool;
+  constructor(private readonly registries:RegistryResolver,config:PoolConfig={connectionString:process.env.DATABASE_URL}){this.pool=new Pool(config);}
+  async transaction<T>(task:(context:TransactionContext)=>Promise<T>):Promise<T>{
+    const client:PoolClient=await this.pool.connect();
+    try{
+      await client.query('BEGIN');
+      const context={queryable:client,states:new PostgresStateRepository(client,this.registries),transitions:new PostgresTransitionRepository(client,this.registries),evidence:new PostgresEvidenceRepository(client)};
+      const result=await task(context); await client.query('COMMIT'); return result;
+    }catch(error){try{await client.query('ROLLBACK')}catch{}throw error;}finally{client.release();}
+  }
+  async close():Promise<void>{await this.pool.end();}
+}
