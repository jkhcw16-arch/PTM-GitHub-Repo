@@ -0,0 +1,17 @@
+import type { State, Transition, SparseVector } from '../../packages/core/model.js';
+import { canonicalize } from '../../packages/core/vector.js';
+import type { AxisRegistry } from '../../packages/core/model.js';
+
+export type StateRow={tenant_id:string;state_id:string;registry_id:string;registry_version:string;temporal_position:Date|string;vector:unknown;provenance_refs:unknown;created_at:Date|string;version:string|number|bigint};
+export type TransitionRow={tenant_id:string;transition_id:string;source_state_id:string;target_state_id:string;registry_id:string;registry_version:string;delta:unknown;created_at:Date|string};
+
+function iso(value:Date|string):string { const d=value instanceof Date?value:new Date(value); if(Number.isNaN(d.valueOf())) throw new Error('INVALID_TIMESTAMP'); return d.toISOString(); }
+function vector(value:unknown):SparseVector { if(!Array.isArray(value)) throw new Error('INVALID_VECTOR_STORAGE'); return value.map((x:any)=>({axis:String(x.axis),value:String(x.value)})); }
+function refs(value:unknown):readonly string[] { if(!Array.isArray(value)) throw new Error('INVALID_PROVENANCE_STORAGE'); return value.map(String); }
+
+export function stateFromRow(row:StateRow, registry:AxisRegistry):State {
+  return {id:row.state_id,tenantId:row.tenant_id,registryId:row.registry_id,registryVersion:row.registry_version,temporalPosition:iso(row.temporal_position),vector:canonicalize(vector(row.vector),registry),provenanceRefs:refs(row.provenance_refs),createdAt:iso(row.created_at)};
+}
+export function transitionFromRow(row:TransitionRow, registry:AxisRegistry):Transition {
+  return {id:row.transition_id,tenantId:row.tenant_id,registryId:row.registry_id,registryVersion:row.registry_version,sourceStateId:row.source_state_id,targetStateId:row.target_state_id,delta:canonicalize(vector(row.delta),registry),createdAt:iso(row.created_at)};
+}
