+name: PTM PostgreSQL Integration
+on:
+  push:
+    branches: [main]
+    paths:
+      - 'adapters/postgres/**'
+      - 'packages/core/**'
+      - 'packages/persistence/**'
+      - 'tests/integration/**'
+      - 'package*.json'
+      - '.github/workflows/postgres-integration.yml'
+  pull_request:
+    branches: [main]
+    paths:
+      - 'adapters/postgres/**'
+      - 'packages/core/**'
+      - 'packages/persistence/**'
+      - 'tests/integration/**'
+      - 'package*.json'
+      - '.github/workflows/postgres-integration.yml'
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  postgres-live:
+    runs-on: ubuntu-latest
+    services:
+      postgres:
+        image: postgres:17-alpine
+        env:
+          POSTGRES_DB: ptm_test
+          POSTGRES_USER: ptm_test
+          POSTGRES_PASSWORD: ptm_test
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U ptm_test -d ptm_test"
+          --health-interval 5s
+          --health-timeout 5s
+          --health-retries 10
+    env:
+      DATABASE_URL: postgresql://ptm_test:ptm_test@127.0.0.1:5432/ptm_test
+    steps:
+      - uses: actions/checkout@v6
+      - uses: actions/setup-node@v6
+        with:
+          node-version: '24'
+          cache: npm
+      - run: npm ci
+      - name: TypeScript compile
+        run: npm run build
+      - name: Apply PostgreSQL schema
+        run: npm run db:migrate
+      - name: Run repository unit tests
+        run: npm test
+      - name: Run live PostgreSQL integration tests
+        run: npm run test:postgres
diff -ruN '--exclude=node_modules' '--exclude=package-lock.json' a/adapters/postgres/README.md b/adapters/postgres/README.md
--- a/adapters/postgres/README.md	1970-01-01 00:00:00.000000000 +0000
+++ b/adapters/postgres/README.md	2026-11-06 11:39:20.030467453 +0000
@@ -0,0 +1,41 @@
+# PostgreSQL adapter
+
+## Install
+
+```bash
+npm install
+```
+
+## Configure
+
+```bash
+export DATABASE_URL='postgresql://user:password@host:5432/ptm'
+```
+
+## Migrate
+
+```bash
+npm run db:migrate
+```
+
+## Behavior
+
+- All user values use PostgreSQL parameters.
+- Tenant ID is included in every primary lookup.
+- Multi-step operations use one checked-out client with `BEGIN`, `COMMIT`, and `ROLLBACK`.
+- State updates use optimistic concurrency through `expectedVersion`.
+- Vectors are canonicalized before persistence and after retrieval.
+- Repository code does not accept dynamic table or column identifiers.
+
+## Live integration tests
+
+The live suite requires a real PostgreSQL server through `DATABASE_URL`:
+
+```bash
+npm run db:migrate
+npm run test:postgres
+```
+
+GitHub Actions runs the suite against a `postgres:17-alpine` service container. The workflow waits for PostgreSQL health before executing migrations and tests.
+
+The live suite verifies schema creation, canonical state round trips, tenant isolation, optimistic concurrency, signed arbitrary-precision deltas, transition lookup, atomic commit, and transaction rollback.
