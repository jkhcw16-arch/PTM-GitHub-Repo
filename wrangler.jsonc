{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ptm-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health/*"
    ]
  },
  "vars": {
    "RELEASE": "development",
    "OIDC_ISSUER": "https://REPLACE_IDP_ISSUER/",
    "OIDC_AUDIENCE": "ptm-api",
    "OIDC_JWKS_URL": "https://REPLACE_IDP_ISSUER/.well-known/jwks.json"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      "localConnectionString": "postgresql://ptm:ptm@127.0.0.1:5432/ptm"
    }
  ]
}
