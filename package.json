{
  "name": "ptm-cloudflare-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "ci:placeholders": "! grep -RIn -e 'REPLACE_' -e 'example.com' --exclude-dir=node_modules --exclude-dir=.git .",
    "ci:types": "wrangler types --env-interface CloudflareBindings types.generated.d.ts",
    "ci:typecheck": "tsc --noEmit",
    "ci:wrangler": "wrangler deploy --dry-run --outdir .wrangler-dist",
    "ci:bundle-secrets": "! grep -RIn -e 'REPLACE_' -e 'client_secret' -e 'postgresql://' -e 'CLOUDFLARE_API_TOKEN' .wrangler-dist",
    "ci:validate": "npm run ci:placeholders && npm run ci:types && npm run ci:typecheck && npm run ci:wrangler && npm run ci:bundle-secrets"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261031.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
